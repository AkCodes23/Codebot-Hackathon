  "faq1_q": "நான் என் மொழியை எப்படித் தேர்வு செய்வது? அதை பின்னர் மாற்ற முடியுமா?",
  "faq1_a": "முதலில் செயலியைத் திறக்கும்போது, ஒரு பட்டியலில் இருந்து மொழியை தேர்வு செய்யலாம். பிறகு அமைப்புகளில் 'மொழி' மூலம் மாற்றலாம்.",
  "faq2_q": "'கிசான்வாணியிடம் கேளுங்கள்' பொத்தான் எதற்காக?",
  "faq2_a": "இது பயன்பாட்டின் முக்கிய குரல் உதவியாளர். சிக்கலான கேள்விகளுக்கு இதை பயன்படுத்தலாம்.",
  "faq3_q": "செயலி கடந்த உரையாடல்களை நினைவில் வைத்திருக்குமா?",
  "faq3_a": "ஆம். எங்கள் AI உரையாடல் நினைவகம் கொண்டுள்ளது.",
  "faq5_q": "'அரசுத் திட்டங்கள்' அம்சம் எப்படி செயல்படுகிறது?",
  "faq5_a": "'அரசுத் திட்டங்கள்' ஐகானைத் தட்டவும். தேவையான விவரங்களை வழங்கும்.",
  "faq6_q": "வானிலை முன்னறிவிப்பை எப்படிப் பெறுவது?",
  "faq6_a": "'வானிலை' ஐகானைத் தட்டவும். உங்கள் இடத்திற்கான தகவல் காட்டப்படும்.",
  "faq7_q": "விவசாய பிரச்சினைக்கு ஆலோசனை எப்படிப் பெறுவது?",
  "faq7_a": "'பயிர் ஆலோசனை' அல்லது 'கிசான்வாணி' குரல் உதவியாளரைப் பயன்படுத்தவும்.",
  "faq8_q": "'விவசாயி சமூக வலைப்பின்னல்' என்றால் என்ன?",
  "faq8_a": "இது பிற விவசாயிகளுடன் இணைக்கும் தளம்.",
  "faq9_q": "'கால்நடைகள்' மற்றும் 'பண்ணை தரவுத்தளம்' எவ்வாறு வேலை செய்கின்றன?",
  "faq9_a": "இவை உங்கள் விலங்குகளைப் பற்றிய தகவல்களைச் சேமிக்க உதவுகிறது.",
  "faq10_q": "'நினைவூட்டல்கள்' எதற்காக?",
  "faq10_a": "அவை முக்கிய நடவடிக்கைகளை நினைவூட்ட உதவுகின்றன.",
