# --- Context Management ---
class ChatContext:
    def __init__(self, max_length: int = MAX_CONTEXT_LENGTH):
        self.context = deque(maxlen=max_length)
        self.search_history = []
        self.reasoning_history = []
        self.user_profile = {
            "location": None,
            "language": "English",
            "voice": "Rachel",
            "preferences": {}
        }
        self.clarification_state = {
            "waiting_for": None,
            "original_query": None,
            "tool": None,
            "parameters": {}
        }
    
    def add_message(self, user_msg: str, assistant_msg: str, reasoning: str = None):
        self.context.append({
            "user": user_msg,
            "assistant": assistant_msg,
            "timestamp": datetime.datetime.now().isoformat(),
            "reasoning": reasoning
        })
    
    def add_search(self, query: str, results: str):
        self.search_history.append({
            "query": query,
            "results": results,
            "timestamp": datetime.datetime.now().isoformat()
        })
    
    def get_context(self) -> List[Dict[str, str]]:
        return list(self.context)
    
    def get_search_history(self) -> List[Dict[str, str]]:
        return self.search_history
    
    def update_profile(self, key: str, value: Any):
        if key in self.user_profile:
            self.user_profile[key] = value
        else:
            self.user_profile["preferences"][key] = value
    
    def get_profile(self) -> Dict[str, Any]:
        return self.user_profile
    
    def set_clarification_state(self, waiting_for: str, original_query: str, tool: str, parameters: Dict[str, Any]):
        self.clarification_state = {
            "waiting_for": waiting_for,
            "original_query": original_query,
            "tool": tool,
            "parameters": parameters
        }
    
    def clear_clarification_state(self):
        self.clarification_state = {
            "waiting_for": None,
            "original_query": None,
            "tool": None,
            "parameters": {}
        }
    
    def clear(self):
        self.context.clear()
        self.search_history.clear()
        self.reasoning_history.clear()
        self.clear_clarification_state()

