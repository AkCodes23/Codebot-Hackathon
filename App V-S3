# --- Thread-Safe Queues & Events for Voice System ---
@st.cache_resource
def get_speech_queue(): 
    return queue.Queue()

@st.cache_resource
def get_tts_finished_event(): 
    return threading.Event()

@st.cache_resource
def get_listening_queue():
    return queue.Queue()

# --- Voice and Speech Infrastructure ---
class VoiceSystem:
    def __init__(self):
        self.engine = None
        self.recognizer = None
        self.microphone = None
        self.is_initialized = False
        self.speech_queue = get_speech_queue()
        self.tts_finished_event = get_tts_finished_event()
        self.listening_queue = get_listening_queue()
        self.voice_thread = None
        self.listening_thread = None
        self.current_language = 'en-US'
        
    def initialize(self, language_code='en-US'):
        """Initialize the voice system with proper error handling."""
        try:
            # Initialize TTS engine
            self.engine = pyttsx3.init()
            self.current_language = language_code
            
            # Configure TTS properties
            self.engine.setProperty('rate', 150)
            self.engine.setProperty('volume', 1.0)
            
            # Set appropriate voice
            voices = self.engine.getProperty('voices')
            target_voice = None
            
            # Try to find a matching voice for the language
            for voice in voices:
                if language_code.split('-')[0].lower() in voice.name.lower():
                    target_voice = voice.id
                    break
            
            # Fallback to English voices if no match found
            if not target_voice:
                for voice in voices:
                    if any(name in voice.name.lower() for name in ['zira', 'david', 'microsoft', 'sapi']):
                        target_voice = voice.id
                        break
            
            if target_voice:
                self.engine.setProperty('voice', target_voice)
            
            # Initialize speech recognition
            self.recognizer = sr.Recognizer()
            self.recognizer.energy_threshold = 300  # Lowered threshold for better sensitivity
            self.recognizer.dynamic_energy_threshold = True
            self.recognizer.pause_threshold = 0.8
            self.recognizer.phrase_threshold = 0.3
            self.recognizer.non_speaking_duration = 0.5
            
            # Initialize microphone
            try:
                self.microphone = sr.Microphone()
                with self.microphone as source:
                    print("Adjusting for ambient noise...")
                    self.recognizer.adjust_for_ambient_noise(source, duration=2.0)
                    print("Ambient noise adjustment complete")
            except Exception as e:
                print(f"Error initializing microphone: {e}")
                st.error(f"Failed to initialize microphone: {str(e)}")
                return False
            
            # Start the speaker thread
            self.voice_thread = threading.Thread(
                target=self._speaker_thread_target,
                daemon=True
            )
            self.voice_thread.start()
            
            self.is_initialized = True
            return True
            
        except Exception as e:
            print(f"Voice system initialization failed: {e}")
            st.error(f"Voice system initialization failed: {str(e)}")
            self.is_initialized = False
            return False
    
    def _speaker_thread_target(self):
        """TTS worker thread with improved error handling."""
        print("Speaker thread started.")
        while True:
            try:
                text_to_speak = self.speech_queue.get()
                if text_to_speak is None:
                    print("Speaker thread received None, stopping...")
                    break
                    
                print(f"Speaking: {text_to_speak}")
                self.engine.say(text_to_speak)
                self.engine.runAndWait()
                print("Finished speaking")
                
            except Exception as e:
                print(f"TTS Thread: ERROR in speaking loop: {e}")
            finally:
                self.tts_finished_event.set()
        print("Speaker thread stopped.")
    
    def _listening_thread_target(self, lang, output_queue):
        """SR worker thread: listens for audio and puts result in queue."""
        print("Listening thread started.")
        try:
            with self.microphone as source:
                print("Listening thread: Adjusting for ambient noise...")
                self.recognizer.adjust_for_ambient_noise(source, duration=1.0)
                print("Listening thread: Now listening...")
                audio = self.recognizer.listen(source, timeout=10, phrase_time_limit=20)
                print("Listening thread: Audio captured. Attempting to recognize speech...")
                text = self.recognizer.recognize_google(audio, language=lang)
                print(f"Listening thread: Successfully recognized text: '{text}'")
                output_queue.put(text)
        except sr.WaitTimeoutError:
            print("Listening thread: Timeout - No speech detected.")
            output_queue.put("TIMEOUT")
        except sr.UnknownValueError:
            print("Listening thread: Speech was unintelligible.")
            output_queue.put("UNCLEAR")
        except sr.RequestError as e:
            print(f"Listening thread: API request error: {e}")
            output_queue.put("ERROR")
        except Exception as e:
            print(f"Listening thread: Unexpected error: {type(e).__name__} - {e}")
            output_queue.put("ERROR")
        print("Listening thread stopped.")

    def speak(self, text):
        """Speak the given text with proper error handling."""
        if not self.is_initialized:
            print("Voice system not initialized")
            return False
            
        if not text or not text.strip():
            print("Empty text received for speech")
            return False
            
        try:
            self.tts_finished_event.clear()
            self.speech_queue.put(text)
            return True
        except Exception as e:
            print(f"Error in speak function: {e}")
            st.error(f"Failed to speak text: {str(e)}")
            return False
    
    def start_listening(self, lang):
        """Starts the listening thread."""
        if not self.is_initialized:
            print("Voice system not initialized, cannot start listening.")
            return False
        if self.listening_thread and self.listening_thread.is_alive():
            print("Listening thread already active.")
            return True
        
        # Clear queue before starting a new listen session
        while not self.listening_queue.empty():
            self.listening_queue.get_nowait()

        self.listening_thread = threading.Thread(
            target=self._listening_thread_target,
            args=(lang, self.listening_queue),
            daemon=True
        )
        self.listening_thread.start()
        print("Started new listening thread.")
        return True

    def get_listening_result(self):
        """Checks for listening result without blocking."""
        try:
            return self.listening_queue.get_nowait()
        except queue.Empty:
            return None

    def cleanup(self):
        """Clean up resources properly."""
        try:
            if self.voice_thread and self.voice_thread.is_alive():
                self.speech_queue.put(None)  # Signal TTS thread to stop
                self.voice_thread.join(timeout=2.0)
            
            if self.listening_thread and self.listening_thread.is_alive():
                # No direct way to stop sr.listen() from outside. 
                # It will timeout eventually. Just let it finish.
                print("Waiting for listening thread to finish timeout...")
                # self.listening_thread.join(timeout=2.0) # Can block UI too much

            if self.engine:
                self.engine.stop()
            
            self.is_initialized = False
            return True
        except Exception as e:
            print(f"Error during cleanup: {e}")
            return False

