# --- AGENT TOOLS ---
def get_current_date():
    return f"Today is {datetime.datetime.now().strftime('%A, %B %d, %Y')}."

def safe_math_eval(node):
    """Safely evaluates an AST node."""
    ops = {
        ast.Add: op.add, ast.Sub: op.sub, ast.Mult: op.mul,
        ast.Div: op.truediv, ast.Pow: op.pow, ast.USub: op.neg
    }
    if isinstance(node, ast.Constant):
        return node.value
    elif isinstance(node, ast.BinOp):
        return ops[type(node.op)](safe_math_eval(node.left), safe_math_eval(node.right))
    elif isinstance(node, ast.UnaryOp):
        return ops[type(node.op)](safe_math_eval(node.operand))
    else:
        raise TypeError("Unsupported operation in mathematical expression")

def calculate_math(expression: str):
    """Calculates a math expression safely."""
    try:
        result = safe_math_eval(ast.parse(expression, mode='eval').body)
        return f"The result of {expression} is {result}."
    except (TypeError, SyntaxError, ValueError, KeyError):
        return "I couldn't solve that. Please state a basic arithmetic expression like '5 times 3'."
    except Exception as e:
        print(f"Math Error: {e}")
        return "I encountered an error trying to solve that."

def tell_joke():
    jokes = [
        "Why don't scientists trust atoms? Because they make up everything!",
        "Why did the scarecrow win an award? Because he was outstanding in his field!",
        "What do you call a sad strawberry? A blueberry."
    ]
    return random.choice(jokes)

def perform_web_search(query: str):
    """General web search tool with improved error handling."""
    tavily_client = get_tavily_client()
    if not tavily_client: return "Search client is not configured due to missing API key."
    try:
        response = tavily_client.search(query=query, search_depth="basic", max_results=3, include_answer=True)
        if response.get("answer"): return response["answer"]
        return "\n".join([f"Source {i+1}: {res['content']}" for i, res in enumerate(response['results'])])
    except Exception as e:
        print(f"CRITICAL: Web search failed. Query: '{query}'. Error: {e}")
        return "Error: I was unable to connect to the search service at this time."

# --- Agentic Logic ---
def generate_agent_response(user_query: str) -> dict:
    """The agent's brain: routes to tools and synthesizes a response."""
    groq_client = get_groq_client()
    if not groq_client: return {"response": KNOWN_FALLBACK_RESPONSES[0]}

    # Get the last few messages from chat history for context
    chat_context = st.session_state.chat_history[-4:] if len(st.session_state.chat_history) > 4 else st.session_state.chat_history
    context_str = "\n".join([f"{msg['role']}: {msg['content']}" for msg in chat_context])

    system_prompt_router = f"""You are a master reasoning agent that decides which tool to use to answer a user's query.
You have access to the recent conversation history for context:
{context_str}

You have the following tools available:
- `get_current_date`: Use ONLY when the user asks for "today's date" or "the current day".
- `get_weather_forecast`: Use for any questions about weather or forecasts. Requires a `location` parameter.
- `get_mandi_prices`: Use for questions about crop prices, market rates, or "mandi bhav". Requires a `crop` and optional `market` parameter.
- `get_farming_advice`: Use for questions about farming techniques, pests, fertilizers, or crop diseases. Requires a `topic` parameter.
- `calculate_math`: Use for solving mathematical expressions. Requires an `expression` parameter.
- `tell_joke`: Use when the user asks for a joke.
- `web_search`: Use as a general-purpose tool for any other query that requires up-to-date information, facts about people, places, or events. Requires a `query` parameter.
- `converse`: Use if no other tool is suitable, for greetings, or for general conversation.

**Instructions:**
1. Analyze the user's query and conversation history to understand their intent and context.
2. If the user's query is ambiguous (like "tell me more about it"), use the conversation history to determine what "it" refers to.
3. Choose the most appropriate tool from the list above.
4. Your output MUST be a JSON object with `tool_to_use`, `thought` (your reasoning), and `parameters` (a dictionary of the arguments needed by the tool).
"""
    
    system_prompt_final_agent = f"""You are KisaanVaani, a friendly and helpful voice assistant for farmers. You will be given information from a tool.
Recent conversation history for context:
{context_str}

1. Present this information to the user in a natural, conversational, and concise way.
2. If the tool was a search, synthesize the key findings into a helpful summary. Do not just list sources.
3. If the tool returned an error, state that you couldn't find the information and apologize.
4. Use the conversation history to maintain context and provide relevant follow-up information.
5. ALWAYS end your response by asking a gentle, open-ended follow-up question like 'Is there anything else I can help with?' or 'What would you like to know next?'."""

    tools = {
        "get_current_date": get_current_date,
        "calculate_math": lambda p: calculate_math(p.get("expression")),
        "tell_joke": tell_joke,
        "get_weather_forecast": lambda p: perform_web_search(f"weather forecast for {p.get('location')}"),
        "get_mandi_prices": lambda p: perform_web_search(f"current price of {p.get('crop')} in {p.get('market', 'India')} mandi"),
        "get_farming_advice": lambda p: perform_web_search(f"best farming practices for {p.get('topic')} site:agrifarming.in OR site:vikaspedia.in"),
        "web_search": lambda p: perform_web_search(p.get("query")),
    }
    
    try:
        # Step 1: Route to the correct tool
        router_messages = [
            {"role": "system", "content": system_prompt_router},
            {"role": "user", "content": user_query}
        ]
        router_completion = groq_client.chat.completions.create(
            messages=router_messages,
            model="llama3-8b-8192",
            temperature=0.0,
            response_format={"type": "json_object"}
        )
        decision = json.loads(router_completion.choices[0].message.content)
        
        thought = decision.get("thought", "No thought was generated.")
        chosen_tool = decision.get("tool_to_use")
        params = decision.get("parameters", {})
        
        # Step 2: Execute the tool
        tool_output = None
        search_feedback = None
        if chosen_tool and chosen_tool != "converse" and chosen_tool in tools:
            # Generate search feedback for the user to see while waiting
            if chosen_tool in ["web_search", "get_weather_forecast", "get_mandi_prices", "get_farming_advice"]:
                 search_query = params.get('query') or params.get('topic') or params.get('location') or params.get('crop')
                 search_feedback = f"🔎 Searching for: *{search_query}*"
            
            tool_function = tools[chosen_tool]
            # Handle tools that may or may not have params
            tool_output = tool_function(params) if params else tool_function()

        # Step 3: Synthesize the final answer
        if tool_output:
            final_messages = [
                {"role": "system", "content": system_prompt_final_agent},
                {"role": "user", "content": f"Here is the information you found: {tool_output}"}
            ]
            final_completion = groq_client.chat.completions.create(
                messages=final_messages,
                model="llama3-8b-8192",
                temperature=0.7
            )
            final_answer = final_completion.choices[0].message.content
        else: # If no tool was chosen or tool was "converse", get a direct conversational response
            final_messages = [
                {"role": "system", "content": system_prompt_final_agent},
                {"role": "user", "content": user_query}
            ]
            final_completion = groq_client.chat.completions.create(
                messages=final_messages,
                model="llama3-8b-8192",
                temperature=0.7
            )
            final_answer = final_completion.choices[0].message.content

        return {"response": final_answer, "feedback": search_feedback, "thought": thought}
        
    except Exception as e:
        print(f"Agent: CRITICAL ERROR in agent logic: {e}")
        return {"response": KNOWN_FALLBACK_RESPONSES[1]}

# --- UI and State Management ---
def display_chat_history():
    for msg in st.session_state.chat_history:
        with st.chat_message(msg["role"]): st.markdown(msg['content'])

def handle_user_input(user_input_text: str, input_source: str = "text"):
    """Processes user input, generates a response, and updates the chat history."""
    st.session_state.app_state = AppState.PROCESSING
    st.session_state.chat_history.append({
        "role": "user", 
        "content": f"🎤 {user_input_text}" if input_source == "voice" else user_input_text
    })
    
    agent_output = generate_agent_response(user_input_text)
    
    # Optionally display thought process in the chat
    if st.session_state.get('reasoning_mode_active') and (thought := agent_output.get("thought")):
        st.session_state.chat_history.append({"role": "assistant", "content": f"🤔 *Thought: {thought}*"})
    
    # Display search feedback immediately for better UX
    if feedback := agent_output.get("feedback"):
        st.session_state.chat_history.append({"role": "assistant", "content": feedback})
    
    # Display and speak the final response
    if response := agent_output.get("response"):
        st.session_state.chat_history.append({"role": "assistant", "content": response})
        if st.session_state.get('voice_conversation_active'):
            st.session_state.app_state = AppState.SPEAKING
            get_voice_system().speak(response)
    else: # If something went wrong and there's no response, return to idle/listening
        st.session_state.app_state = AppState.IDLE if not st.session_state.get('voice_conversation_active') else AppState.LISTENING

# --- Main App Logic ---
def run_kisaanvaani_app():
    st.set_page_config(page_title="KisaanVaani", layout="centered")
    st.title("🌾 KisaanVaani Demo")

    # Initial setup of session state
    if 'app_state' not in st.session_state:
        st.session_state.update({
            "app_state": AppState.IDLE,
            "chat_history": [{"role": "assistant", "content": "Welcome to KisaanVaani! How can I assist you today?"}],
            "voice_conversation_active": False,
            "reasoning_mode_active": False,
            "selected_language_code": 'en-US',
            "selected_language_name": 'english',
            "voice_system_initialized": False,
            "start_listening_now": False # New flag to control listening flow
        })

    # Validate API keys on startup
    if not GROQ_API_KEY or not TAVILY_API_KEY:
        st.error("🚨 Missing API Keys! Please configure GROQ_API_KEY and TAVILY_API_KEY in your Streamlit secrets.")
        st.stop()
    
    # --- Sidebar for Settings ---
    st.sidebar.header("Settings")
    st.sidebar.toggle("🧠 Show Agent Reasoning", key="reasoning_mode_active", help="See the agent's thought process in the chat.")
    st.sidebar.header("Voice Conversation")

    # Language selection
    selected_language = st.sidebar.selectbox(
        "Select Language",
        options=list(SUPPORTED_LANGUAGES.keys()),
        index=0,
        key="selected_language_name"
    )
    st.session_state.selected_language_code = SUPPORTED_LANGUAGES[selected_language]

    is_voice_active = st.session_state.voice_conversation_active
    voice_system = get_voice_system()

    if not is_voice_active:
        if st.sidebar.button("🎤 Start Voice Demo", type="primary", use_container_width=True):
            try:
                if voice_system.initialize(st.session_state.selected_language_code):
                    st.session_state.voice_system_initialized = True
                    st.session_state.voice_conversation_active = True
                    st.session_state.app_state = AppState.SPEAKING
                    
                    greeting = "Hello! I am KisaanVaani, your farming assistant. How can I help you today?"
                    voice_system.speak(greeting)
                    st.session_state.chat_history.append({"role": "assistant", "content": greeting})
                    st.rerun()
                else:
                    st.error("Failed to initialize voice system. Please check your system settings.")
            except Exception as e:
                st.error(f"Failed to initialize voice mode: {str(e)}")
                st.session_state.voice_conversation_active = False
                st.session_state.voice_system_initialized = False
    else:
        if st.sidebar.button("🛑 Stop Voice Demo", type="secondary", use_container_width=True):
            voice_system.cleanup()
            st.session_state.voice_conversation_active = False
            st.session_state.app_state = AppState.IDLE
            st.session_state.voice_system_initialized = False
            st.session_state.start_listening_now = False # Reset flag on stop
            st.rerun()

    # --- Main Interface ---
    status_container = st.empty()
    display_chat_history()

    # Voice interaction state machine
    if is_voice_active and st.session_state.voice_system_initialized:
        current_state = st.session_state.app_state
        
        if current_state == AppState.SPEAKING:
            status_container.status("🗣️ KisaanVaani is speaking...", state="running")
            if voice_system.tts_finished_event.wait(timeout=0.1):
                st.session_state.app_state = AppState.LISTENING
                st.session_state.start_listening_now = True # Signal to start listening on next rerun
                st.rerun() # Trigger a rerun to display 'Listening...' bar

        elif current_state == AppState.PROCESSING:
            status_container.status("🤔 Thinking...", state="running")

    # --- Dedicated Voice Listening Flow (runs on subsequent rerun after state change) ---
    # This block will execute in a *new* rerun cycle, allowing the UI to update first.
    if st.session_state.get('voice_conversation_active') and \
       st.session_state.get('voice_system_initialized') and \
       st.session_state.app_state == AppState.LISTENING and \
       st.session_state.start_listening_now:
        
        st.session_state.start_listening_now = False # Clear flag immediately to prevent infinite loop
        
        status_container.status("🎤 **Listening...** Say your query", state="running") # Ensure bar is displayed
        
        # Start the listening thread
        voice_system.start_listening(st.session_state.selected_language_code)

    # Check for results from the listening queue (non-blocking)
    if st.session_state.get('voice_conversation_active') and \
       st.session_state.get('voice_system_initialized') and \
       st.session_state.app_state == AppState.LISTENING:
        
        voice_result = voice_system.get_listening_result()
        
        if voice_result is not None:
            if voice_result not in ["TIMEOUT", "UNCLEAR", "ERROR"]:
                handle_user_input(voice_result, input_source="voice") # Pass input_source
                # handle_user_input will rerun, which is desired
            elif voice_result == "TIMEOUT":
                st.session_state.chat_history.append({"role": "assistant", "content": "⏰ I didn't hear anything. Please ensure your microphone is active and try speaking again."}) # Add to chat history
                st.session_state.app_state = AppState.LISTENING # Stay in listening state
                st.session_state.start_listening_now = True # Re-initiate listening for the next rerun
                st.rerun()
            elif voice_result == "UNCLEAR":
                error_message = "❓ I couldn't quite understand what you said. Could you please speak clearly and repeat that?"
                voice_system.speak(error_message)
                st.session_state.chat_history.append({"role": "assistant", "content": error_message})
                st.session_state.app_state = AppState.SPEAKING # Speak error, then back to listening
                st.rerun()
            else: # ERROR case
                error_message = "⚠️ Sorry, I'm having a bit of trouble with speech recognition at the moment. Please try again shortly."
                voice_system.speak(error_message)
                st.session_state.chat_history.append({"role": "assistant", "content": error_message})
                st.session_state.app_state = AppState.SPEAKING # Speak error, then back to listening
                st.rerun()
        else:
            # If no result yet, and we are supposed to be listening, continue to display listening status
            status_container.status("🎤 **Listening...** Say your query", state="running")

    # Show text input only when voice mode is off
    if not is_voice_active:
        if text_input := st.chat_input("Type your message here:"):
            handle_user_input(text_input, input_source="text") # Pass input_source
            st.rerun()


if __name__ == "__main__":
    run_kisaanvaani_app()
